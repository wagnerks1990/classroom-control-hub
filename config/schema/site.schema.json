{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-hub.local/schema/site.schema.json",
  "title": "Classroom Control Hub Site Configuration",
  "type": "object",
  "properties": {
    "site": {
      "type": "object",
      "properties": {
        "name": {"type":"string","minLength":1,"maxLength":120},
        "room": {"type":"string","minLength":1,"maxLength":80},
        "timezone": {"type":"string","minLength":1}
      },
      "required": ["room","timezone"]
    },
    "displays": {
      "type":"object",
      "properties":{"count":{"type":"integer","minimum":1,"maximum":64}}
    }
  },
  "required": ["site"]
}
