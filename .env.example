# RoomGoblin
ROOM_NAME=Classroom
TZ=America/New_York
SCHEDULER_TIMEZONE=America/New_York
# Temporary HTTP-only deployment. TLS/reverse-proxy support is deferred.
HUB_PORT=3000
HUB_BIND_ADDRESS=0.0.0.0
# Maintenance always listens on 127.0.0.1; choose a free, distinct host port.
MAINTENANCE_PORT=3010

# Optional first-start/migration integration fallbacks.
# After setup, manage these connections in Settings -> Integrations & Hardware.
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
PLUTO_URL=
VEYON_WEBAPI_URL=http://127.0.0.1:11080
VEYON_KEY_NAME=master
VEYON_SCAN_SUBNET=
MUSIC_ASSISTANT_URL=http://127.0.0.1:8095
MORNING_ANNOUNCEMENTS_URL=

# Managed Display Gateway.
# Comma-separated hostname=IPv4 overrides are resolved only inside the Hub process;
# TLS still uses the original hostname for Host/SNI. Hosts present in overrides are
# automatically allowlisted for /display-gateway/. Add additional approved public
# hosts with DISPLAY_GATEWAY_ALLOWED_HOSTS. Never use this as an arbitrary open proxy.
DISPLAY_GATEWAY_OVERRIDES=
DISPLAY_GATEWAY_ALLOWED_HOSTS=

# Access control
CONTROL_TOKEN=
# Legacy migration fallback only. Enroll displays and disable shared-token access in Settings.
DISPLAY_TOKEN=
LAB_AGENT_TOKEN=
SETUP_TOKEN=
MAINTENANCE_TOKEN=
MAINTENANCE_PROXY_ENABLED=true
MAINTENANCE_ALLOW_SHELL=false
MAINTENANCE_ALLOW_UNSAFE_SOURCE_UPDATES=false
MANAGED_APP_CONTAINER=classroom-control-hub
RESTORE_HEALTH_TIMEOUT_MS=60000
RESTORE_MAX_EXPANDED_MB=4096
SESSION_PARTICIPATION_ENABLED=false
CORS_ALLOWED_ORIGINS=
WS_MAX_PAYLOAD_MB=16

# Persistent storage / host paths
HOST_CLASSROOM_HUB_DIR=/opt/classroom-hub
HOST_SERVICES_DIR=/opt/services
HOST_BACKUP_DIR=/opt/classroom-hub-backups
# Canonical SQLite database for new installs and post-alpha.70 migrations.
DATABASE_FILE=/app/data/classroom-control-hub.db
CLASSROOM_HUB_MASTER_KEY_FILE=/etc/classroom-control-hub/master.key
MASTER_KEY_FILE=/run/secrets/classroom-control-hub-master-key
LEGACY_JSON_MIRROR=false

# Direct HTTP exposure / login protection
# Keep 0 unless a trusted reverse proxy is explicitly added later.
TRUST_PROXY_HOPS=0
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
LOGIN_LOCK_MS=900000

# Configure school cycles, day groups, periods, and calendar exceptions in the web controller.
