# Classroom Control Hub
ROOM_NAME=Classroom
TZ=America/New_York
SCHEDULER_TIMEZONE=America/New_York
HUB_PORT=3000

# Optional integrations
MQTT_URL=mqtt://host.docker.internal:1883
MQTT_USERNAME=
MQTT_PASSWORD=
PLUTO_URL=
VEYON_WEBAPI_URL=http://host.docker.internal:11080
VEYON_KEY_NAME=ClassroomControlHub
VEYON_SCAN_SUBNET=
MUSIC_ASSISTANT_URL=http://host.docker.internal:8095
MORNING_ANNOUNCEMENTS_URL=

# Access control
CONTROL_TOKEN=
DISPLAY_TOKEN=
SETUP_TOKEN=
MAINTENANCE_TOKEN=
MAINTENANCE_PROXY_ENABLED=false
MAINTENANCE_ALLOW_SHELL=false
MAINTENANCE_ALLOW_UNSAFE_SOURCE_UPDATES=false
MANAGED_APP_CONTAINER=classroom-control-hub
RESTORE_HEALTH_TIMEOUT_MS=60000
RESTORE_MAX_EXPANDED_MB=4096
SESSION_PARTICIPATION_ENABLED=false
CORS_ALLOWED_ORIGINS=
WS_MAX_PAYLOAD_MB=16

# Persistent storage / host paths
HOST_CLASSROOM_HUB_DIR=/opt/classroom-hub
HOST_SERVICES_DIR=/opt/services
DATABASE_FILE=/app/data/classroom-control-hub.db
CLASSROOM_HUB_MASTER_KEY_FILE=/etc/classroom-control-hub/master.key
MASTER_KEY_FILE=/run/secrets/classroom-control-hub-master-key
LEGACY_JSON_MIRROR=false

# Reverse proxy / login protection
TRUST_PROXY_HOPS=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
LOGIN_LOCK_MS=900000

# Optional school-cycle anchor. Configure these to match your local calendar.
SCHOOL_CALENDAR_ANCHOR_DATE=2026-08-19
SCHOOL_CALENDAR_ANCHOR_CYCLE_DAY=A
SCHOOL_CALENDAR_ANCHOR_DAY_COLOR=Green
